generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["naphung"]
}

model TblAccount {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String?  @map("full_name")
  phone        String?
  role         String   @default("user")
  status       String   @default("active")
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tbl_account")
  @@schema("naphung")
}

model TblCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  imageUrl  String?  @map("image_url")
  parentId  String?  @map("parent_id") @db.Uuid
  parent    TblCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children  TblCategory[] @relation("CategoryHierarchy")
  products  TblProduct[]
  sortOrder Int      @default(0) @map("sort_order")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([parentId])
  @@map("tbl_category")
  @@schema("naphung")
}

model TblCarousel {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  eyebrow     String?
  description String?
  href        String   @default("#san-pham")
  cta         String   @default("Xem sản phẩm")
  imageUrl    String   @map("image_url")
  sortOrder   Int      @default(0) @map("sort_order")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, sortOrder])
  @@map("tbl_carousel")
  @@schema("naphung")
}

model TblProduct {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String            @unique
  description String?
  price       Int
  imageUrl    String?           @map("image_url")
  categoryId  String?           @map("category_id") @db.Uuid
  category    TblCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images      TblProductImage[]
  sortOrder   Int               @default(0) @map("sort_order")
  featured    Boolean           @default(false)
  status      String            @default("active")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([categoryId])
  @@index([status, featured, sortOrder])
  @@map("tbl_product")
  @@schema("naphung")
}

model TblProductImage {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String     @map("product_id") @db.Uuid
  product   TblProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String     @map("image_url")
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([productId, sortOrder])
  @@map("tbl_product_image")
  @@schema("naphung")
}
